using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace INVENTORY
{
    public partial class Form1 : Form
    {
        // Khởi tạo đối tượng tầng nghiệp vụ xử lý
        private KhoBUS khoBUS = new KhoBUS();

        public Form1()
        {
            InitializeComponent();
            cboLoaiPhieu.SelectedIndex = 0; // Mặc định hiển thị phiếu NHAP lúc chạy Form
        }

        // 1. Sự kiện thêm vật tư tạm thời vào lưới DataGridView (Chưa lưu xuống database)
        private void btnThemVatTu_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrEmpty(txtMaVatTu.Text) || string.IsNullOrEmpty(txtSoLuong.Text) || string.IsNullOrEmpty(txtDonGia.Text))
            {
                MessageBox.Show("Vui lòng nhập đầy đủ: Mã vật tư, số lượng và đơn giá!", "Cảnh báo thiếu thông tin", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Thêm thông tin từ các ô TextBox vào các cột tương ứng trên DataGridView dgvChiTiet
            dgvChiTiet.Rows.Add(txtMaVatTu.Text, txtSoLuong.Text, txtDonGia.Text);

            // Tính toán lại tổng tiền hiển thị thời gian thực
            TinhTongTienPhieu();

            // Clear nhanh dữ liệu ô vừa nhập để chuẩn bị cho vật tư kế tiếp
            txtMaVatTu.Clear();
            txtSoLuong.Clear();
            txtDonGia.Clear();
            txtMaVatTu.Focus();
        }

        // Hàm hỗ trợ duyệt DataGridView để tính toán cộng dồn tổng tiền phiếu
        private void TinhTongTienPhieu()
        {
            decimal tongTien = 0;
            foreach (DataGridViewRow row in dgvChiTiet.Rows)
            {
                if (row.Cells["SoLuong"].Value != null && row.Cells["DonGia"].Value != null)
                {
                    decimal sl = Convert.ToDecimal(row.Cells["SoLuong"].Value);
                    decimal dg = Convert.ToDecimal(row.Cells["DonGia"].Value);
                    tongTien += sl * dg;
                }
            }
            lblTongTien.Text = tongTien.ToString("N0") + " VND";
        }

        // 2. Sự kiện nhấn nút Lưu Phiếu Kho xuống Cơ sở dữ liệu bằng SqlTransaction
        private void btnLuuPhieu_Click(object sender, EventArgs e)
        {
            try
            {
                // Thu thập dữ liệu từ Giao diện đưa vào DTO Phiếu Kho
                PhieuKhoDTO phieu = new PhieuKhoDTO();
                phieu.LoaiPhieu = cboLoaiPhieu.Text;
                phieu.NgayLap = dtpNgayLap.Value;
                phieu.MaNCC = string.IsNullOrEmpty(txtMaNCC.Text) ? (int?)null : int.Parse(txtMaNCC.Text);

                // Định dạng lại chuỗi tổng tiền thành dạng số thuần túy để lưu
                string cleanAmount = lblTongTien.Text.Replace(" VND", "").Replace(",", "").Replace(".", "");
                phieu.TongTien = decimal.Parse(cleanAmount);

                // Thu thập danh sách chi tiết vật tư từ lưới DataGridView
                List<ChiTietPhieuKhoDTO> dsChiTiet = new List<ChiTietPhieuKhoDTO>();
                foreach (DataGridViewRow row in dgvChiTiet.Rows)
                {
                    if (row.Cells["MaVatTu"].Value != null)
                    {
                        dsChiTiet.Add(new ChiTietPhieuKhoDTO()
                        {
                            MaVatTu = row.Cells["MaVatTu"].Value.ToString(),
                            SoLuong = Convert.ToDecimal(row.Cells["SoLuong"].Value),
                            DonGia = Convert.ToDecimal(row.Cells["DonGia"].Value)
                        });
                    }
                }

                // Gửi thông tin sang tầng BUS xử lý đồng bộ giao dịch kho
                string msgError;
                bool ketQua = khoBUS.LuuPhieuKhoHethong(phieu, dsChiTiet, out msgError);

                if (ketQua)
                {
                    MessageBox.Show("Xử lý giao dịch kho thành công! Số lượng tồn kho đa bảng đã được cập nhật.", "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    dgvChiTiet.Rows.Clear(); // Xóa sạch dữ liệu cũ trên lưới sau khi lưu xong
                    lblTongTien.Text = "0";
                    txtMaNCC.Clear();
                }
                else
                {
                    // Thông báo lỗi nếu hệ thống thực hiện Rollback (Ví dụ: Không đủ hàng xuất)
                    MessageBox.Show(msgError, "Giao dịch thất bại (Đã Rollback hệ thống)", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi định dạng dữ liệu đầu vào: " + ex.Message, "Cảnh báo lỗi nhập liệu", MessageBoxButtons.OK, MessageBoxIcon.Stop);
            }
        }

        // 3. Sự kiện tính tổng trị giá tồn kho bằng lệnh ExecuteScalar
        private void btnTinhTongKho_Click(object sender, EventArgs e)
        {
            decimal tongKho = khoBUS.LayTongTriGiaTon();
            MessageBox.Show($"Tổng giá trị hàng hóa hiện đang tồn kho là:\n{tongKho.ToString("N2")} VND", "Báo cáo giá trị tồn kho", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }
    }
}
