using System;
using System.Collections.Generic;

namespace INVENTORY
{
    public class KhoBUS
    {
        private KhoDAL khoDAL = new KhoDAL();

        public decimal LayTongTriGiaTon()
        {
            return khoDAL.TinhTongTriGiaTonKho();
        }

        public bool LuuPhieuKhoHethong(PhieuKhoDTO phieu, List<ChiTietPhieuKhoDTO> dsChiTiet, out string msg)
        {
            // Kiểm tra các ràng buộc logic nghiệp vụ trước khi gọi tầng DAL
            if (dsChiTiet == null || dsChiTiet.Count == 0)
            {
                msg = "Lỗi nghiệp vụ: Danh sách chi tiết vật tư trong phiếu đang trống.";
                return false;
            }
            if (phieu.LoaiPhieu == "NHAP" && (phieu.MaNCC == null || phieu.MaNCC <= 0))
            {
                msg = "Lỗi nghiệp vụ: Phiếu nhập kho bắt buộc phải chọn mã Nhà Cung Cấp.";
                return false;
            }

            return khoDAL.ThucHienGiaoDichKho(phieu, dsChiTiet, out msg);
        }
    }
}
