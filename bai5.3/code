using System;
using System.Collections.Generic;
using System.Data;
using MySql.Data.MySqlClient; // Giữ nguyên thư viện MySQL theo hệ thống XAMPP của bạn

namespace INVENTORY
{
    public class DbConnectionData
    {
        public static string ConnectionString { get; } = "Server=localhost;Database=InventoryDB;Uid=root;Pwd=;";
    }

    public class KhoDAL
    {
        public bool ThucHienGiaoDichKho(PhieuKhoDTO phieu, List<ChiTietPhieuKhoDTO> dsChiTiet, out string errorMsg)
        {
            errorMsg = string.Empty;

            // Sử dụng khối using để tự động giải phóng kết nối một cách an toàn nhất
            using (MySqlConnection conn = new MySqlConnection(DbConnectionData.ConnectionString))
            {
                conn.Open();
                // Khởi tạo MySqlTransaction 
                MySqlTransaction trans = conn.BeginTransaction();

                try
                {
                    // Bước 1: Chèn bản ghi vào bảng PhieuKho và lấy Id vừa sinh bằng LAST_INSERT_ID()
                    string queryPhieu = @"INSERT INTO PhieuKho (LoaiPhieu, NgayLap, MaNCC, TongTien) 
                                          VALUES (@LoaiPhieu, @NgayLap, @MaNCC, @TongTien);
                                          SELECT LAST_INSERT_ID();";

                    int maPhieuMoi;
                    using (MySqlCommand cmdPhieu = new MySqlCommand(queryPhieu, conn, trans))
                    {
                        cmdPhieu.Parameters.AddWithValue("@LoaiPhieu", phieu.LoaiPhieu);
                        cmdPhieu.Parameters.AddWithValue("@NgayLap", phieu.NgayLap);
                        cmdPhieu.Parameters.AddWithValue("@MaNCC", (object)phieu.MaNCC ?? DBNull.Value);
                        cmdPhieu.Parameters.AddWithValue("@TongTien", phieu.TongTien);
                        maPhieuMoi = Convert.ToInt32(cmdPhieu.ExecuteScalar());
                    }

                    // Bước 2: Duyệt danh sách chi tiết để chèn và cập nhật số lượng tồn kho
                    foreach (var item in dsChiTiet)
                    {
                        // 2.1 Chèn dữ liệu vào bảng ChiTietPhieuKho
                        string queryCT = @"INSERT INTO ChiTietPhieuKho (MaPhieu, MaVatTu, SoLuong, DonGia) 
                                           VALUES (@MaPhieu, @MaVatTu, @SoLuong, @DonGia)";
                        using (MySqlCommand cmdCT = new MySqlCommand(queryCT, conn, trans))
                        {
                            cmdCT.Parameters.AddWithValue("@MaPhieu", maPhieuMoi);
                            cmdCT.Parameters.AddWithValue("@MaVatTu", item.MaVatTu);
                            cmdCT.Parameters.AddWithValue("@SoLuong", item.SoLuong);
                            cmdCT.Parameters.AddWithValue("@DonGia", item.DonGia);
                            cmdCT.ExecuteNonQuery();
                        }

                        // 2.2 Cập nhật biến động số lượng tồn của bảng VatTu
                        string queryUpdateKho = phieu.LoaiPhieu == "NHAP"
                            ? "UPDATE VatTu SET SoLuongTon = SoLuongTon + @SoLuong WHERE MaVatTu = @MaVatTu"
                            : "UPDATE VatTu SET SoLuongTon = SoLuongTon - @SoLuong WHERE MaVatTu = @MaVatTu";

                        using (MySqlCommand cmdUpdate = new MySqlCommand(queryUpdateKho, conn, trans))
                        {
                            cmdUpdate.Parameters.AddWithValue("@SoLuong", item.SoLuong);
                            cmdUpdate.Parameters.AddWithValue("@MaVatTu", item.MaVatTu);
                            cmdUpdate.ExecuteNonQuery();
                        }
                    }

                    // Bước 3: KIỂM TRA ĐỒNG LOẠT TỒN KHO SAU KHI CẬP NHẬT (Sửa lỗi logic cộng dồn của bạn)
                    // Nếu phiếu XUẤT làm cho SoLuongTon của bất kỳ vật tư nào bị âm (< 0), hệ thống sẽ chặn đứng ngay
                    if (phieu.LoaiPhieu == "XUAT")
                    {
                        string queryCheckTon = @"SELECT v.MaVatTu, v.TenVatTu, v.SoLuongTon 
                                                 FROM VatTu v 
                                                 WHERE v.MaVatTu IN (SELECT DISTINCT MaVatTu FROM ChiTietPhieuKho WHERE MaPhieu = @MaPhieu)
                                                   AND v.SoLuongTon < 0";

                        using (MySqlCommand cmdCheck = new MySqlCommand(queryCheckTon, conn, trans))
                        {
                            cmdCheck.Parameters.AddWithValue("@MaPhieu", maPhieuMoi);
                            using (MySqlDataReader reader = cmdCheck.ExecuteReader())
                            {
                                if (reader.HasRows)
                                {
                                    string danhSachLoi = "";
                                    while (reader.Read())
                                    {
                                        danhSachLoi += $"\n- Vật tư [{reader["MaVatTu"]}] {reader["TenVatTu"]} không đủ hàng xuất! (Thiếu hụt sau khi trừ)";
                                    }
                                    throw new Exception("Không đủ hàng trong kho!" + danhSachLoi);
                                }
                            }
                        }
                    }

                    // Toàn bộ các bước kiểm tra thành công hợp lệ -> Commit xác nhận lưu vĩnh viễn
                    trans.Commit();
                    return true;
                }
                catch (Exception ex)
                {
                    // Hoàn nguyên (Rollback) toàn bộ dữ liệu về trạng thái cũ nếu gặp lỗi
                    if (trans != null) trans.Rollback();
                    errorMsg = ex.Message;
                    return false;
                }
            }
        }

        // 3. Sử dụng ExecuteScalar tính tổng giá trị hàng hóa đang tồn kho (Giữ nguyên hàm IFNULL của MySQL)
        public decimal TinhTongTriGiaTonKho()
        {
            using (MySqlConnection conn = new MySqlConnection(DbConnectionData.ConnectionString))
            {
                string query = @"SELECT IFNULL(SUM(v.SoLuongTon * 
                                 IFNULL((SELECT ct.DonGia FROM ChiTietPhieuKho ct WHERE ct.MaVatTu = v.MaVatTu ORDER BY ct.MaPhieu DESC LIMIT 1), 0)), 0) 
                                 FROM VatTu v";

                using (MySqlCommand cmd = new MySqlCommand(query, conn))
                {
                    conn.Open();
                    object res = cmd.ExecuteScalar();
                    return Convert.ToDecimal(res);
                }
            }
        }
    }
}
